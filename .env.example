# Local development environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is listed in .gitignore.

# ── Google Gemini ────────────────────────────────────────────────────────────
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Recruiter Credentials ────────────────────────────────────────────────────
# The recruiter login user ID (username).
RECRUITER_USER_ID=your_recruiter_username_here

# Preferred: PBKDF2-SHA256 hashed password (salt$hash format).
# Generate with: python -c "from utils import hash_password; print(hash_password('YourPassword'))"
RECRUITER_PASSWORD_HASH=your_pbkdf2_hash_here

# Fallback for local dev ONLY (not recommended — use RECRUITER_PASSWORD_HASH instead):
# RECRUITER_PASSWORD=your_plaintext_password_here
